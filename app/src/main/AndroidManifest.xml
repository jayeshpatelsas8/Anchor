<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================ -->
    <!-- PERMISSIONS                                  -->
    <!-- ============================================ -->

    <!-- SMS: receive commands and send replies -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Location: GPS acquisition for locate/trace -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Phone: callback feature -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Overlay: full-screen alert during ring command -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Contacts: whitelist import from contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Audio: sound mode control and ringtone playback -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground service + GPS survival -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- AlarmManager: precise wake-ups for BURST-mode trace -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- CRITICAL FIX: RECEIVE_BOOT_COMPLETED allows the app to restart
         after a device reboot. Without this, if the phone restarts, the
         app is not started and SMS commands won't work until the user
         manually opens the app. Essential for lost-device recovery. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

        <!-- Already declared for other features, but ensure it's there: -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    
    <!-- ============================================ -->
    <!-- APPLICATION                                  -->
    <!-- ============================================ -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.anchor"
        tools:ignore="DataExtractionRules"
        tools:targetApi="31">

        <!-- Activities -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.anchor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".PermissionsActivity" android:exported="false" />
        <activity android:name=".WhitelistActivity" android:exported="false" />
        <activity android:name=".CommandSettingsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false" />

        <!-- FileProvider: exposes debug logs for sharing/opening -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Services -->
        <service
            android:name=".service.LocationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".service.TraceForegroundService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".service.OverlayDisplayService"
            android:enabled="true"
            android:exported="false" />

        <!-- Receivers -->

        <!-- Standard text SMS receiver -->
        <!-- CRITICAL FIX: Added android:priority="999" so Anchor receives
             the ordered SMS_RECEIVED broadcast BEFORE the default SMS app
             can call abortBroadcast(). Without this, Google Messages or
             the system SMS app may consume the broadcast before Anchor sees it. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Binary/data SMS receiver on port 15000 -->
        <receiver
            android:name=".receiver.DataSmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.intent.action.DATA_SMS_RECEIVED" />
                <data
                    android:scheme="sms"
                    android:host="localhost"
                    android:port="15000" />
            </intent-filter>
        </receiver>

        <!-- AlarmManager heartbeat for trace BURST mode -->
        <receiver
            android:name=".receiver.TraceAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- CRITICAL FIX: Boot receiver. Re-registers trace alarms after
             device reboot so BURST-mode trace continues working. Without this,
             a reboot kills the trace permanently until the user manually
             sends "trace" again. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
