<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential for SMS commands functionality -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" android:protectionLevel="dangerous" />
    <uses-permission android:name="android.permission.SEND_SMS" android:protectionLevel="dangerous" />
    
    <!-- Location permissions - required for locating the device -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:protectionLevel="dangerous" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:protectionLevel="dangerous" />
    <!-- Background location is only requested when explicitly needed -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" android:protectionLevel="dangerous" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- For "callme" feature - to call back the owner -->
    <uses-permission android:name="android.permission.CALL_PHONE" android:protectionLevel="dangerous" />
    
    <!-- For overlay UI during remote control -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- For contact selection in whitelist - only used if user chooses to add contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" android:protectionLevel="dangerous" />
    
    <!-- For remote ringing functionality -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
 
     <!-- Existing permissions -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- NEW: Required for foreground service -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    
    <!-- Required for LocationUtils to keep CPU alive during GPS fix -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.anchor"
        tools:targetApi="31"
        tools:ignore="DataExtractionRules">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.anchor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
    android:name=".service.LocationForegroundService"

android:enabled="true"
 
android:exported="false"
    android:foregroundServiceType="location" />

        
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
            
        <activity
            android:name=".PermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".WhitelistActivity"
            android:exported="false" />

        <!-- SMS Receiver - for processing SMS commands -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Overlay Display Service - for showing alerts when device is locked/lost -->
        <service
            android:name=".service.OverlayDisplayService"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".CommandSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".AboutActivity"
            android:exported="false" />
    </application>

</manifest>